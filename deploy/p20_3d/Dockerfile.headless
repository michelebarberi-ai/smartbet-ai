# P20.3D STAGING: real Flutter SDK + Node headless job host.
# A fixed Flutter release tag must be provided in the Render service settings.
# Do not put keys or secrets in Docker ARG, images or committed files.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git unzip xz-utils zip libglu1-mesa \
    libgtk-3-0 libstdc++6 clang cmake ninja-build pkg-config \
    libsecret-1-dev && rm -rf /var/lib/apt/lists/*
ARG FLUTTER_REF
RUN test -n "$FLUTTER_REF" && \
    git clone --depth 1 --branch "$FLUTTER_REF" \
      https://github.com/flutter/flutter.git /opt/flutter
ENV PATH="/opt/flutter/bin:/opt/flutter/bin/cache/dart-sdk/bin:${PATH}"
RUN git config --global --add safe.directory /opt/flutter && \
    flutter config --no-analytics && flutter precache --linux
WORKDIR /app
COPY . /app
RUN npm ci --prefix backend --omit=dev && flutter pub get
CMD ["node", "backend/auto_coupon/official_headless_runner.js"]
